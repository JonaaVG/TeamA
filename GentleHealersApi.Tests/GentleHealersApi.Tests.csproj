<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GentleHealersApi\GentleHealersApi.csproj" />
  </ItemGroup>

  <!-- The shared test branch may already provide the same Selenium dependency. -->
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Selenium.WebDriver'))' == ''">
    <PackageReference Include="Selenium.WebDriver" Version="4.53.0" />
  </ItemGroup>

</Project>
